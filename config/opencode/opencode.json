{
  "$schema": "https://opencode.ai/schemas/opencode.json",
  "instructions": [
    "~/.config/opencode/identity.md",
    "~/.config/opencode/rules.yaml",
    "~/.config/opencode/shell_strategy.md",
    "~/.config/opencode/mcp-tools.md",
    "~/.config/opencode/MORPH_INSTRUCTIONS.md",
    "~/.config/opencode/goost_instructions.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "http://localhost:6276/mcp",
      "enabled": false,
      "_note": "Enable after setting up context7 MCP server - see README"
    },
    "kagimcp": {
      "type": "remote",
      "url": "http://localhost:6279/mcp",
      "enabled": false,
      "_note": "Enable after setting up kagi MCP server - see README"
    },
    "arxiv-mcp": {
      "type": "remote",
      "url": "http://localhost:6280/mcp",
      "enabled": false,
      "_note": "Enable after setting up arxiv MCP server - see README"
    },
    "firecrawl": {
      "type": "remote",
      "url": "http://localhost:6281/mcp",
      "enabled": false,
      "_note": "Enable after setting up firecrawl MCP server - see README"
    },
    "time": {
      "type": "remote",
      "url": "http://localhost:6282/mcp",
      "enabled": true,
      "_note": "Simple time server - usually works out of box"
    },
    "fetch-mcp": {
      "type": "remote",
      "url": "http://localhost:6283/mcp",
      "enabled": false,
      "_note": "Enable after setting up fetch MCP server - see README"
    }
  },
  "plugin": [
    "opencode-antigravity-auth@latest"
  ],
  "provider": {
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "antigravity-claude-sonnet-4-5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingConfig": { "thinkingBudget": 8192 } },
            "max": { "thinkingConfig": { "thinkingBudget": 32768 } }
          }
        },
        "antigravity-claude-opus-4-5-thinking": {
          "name": "Claude Opus 4.5 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingConfig": { "thinkingBudget": 8192 } },
            "max": { "thinkingConfig": { "thinkingBudget": 32768 } }
          }
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        }
      }
    }
  },
  "keybinds": {
    "input_newline": "shift+return"
  },
  "tools": {
    "bash": true
  }
}
